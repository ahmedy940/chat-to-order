# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google AI Studio key from a project without billing (free tier): https://aistudio.google.com
GEMINI_API_KEY=
# Optional model overrides (defaults are free-tier models)
GEMINI_READ_MODEL=gemini-3.6-flash
GEMINI_INTENT_MODEL=gemini-3.5-flash-lite

# PayPal developer dashboard > Apps & Credentials > Sandbox: https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The same value as PAYPAL_CLIENT_ID. It's public by design: the pay page loads PayPal's buttons with it.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Where the app runs; used to build pay links
APP_BASE_URL=http://localhost:3000
